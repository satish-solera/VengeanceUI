{
  "$schema": "https://turbo.build/schema.json",
  "version": "2",
  "tasks": {
    "build": {
      "description": "Build the project",
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"],
      "cache": true
    },
    "dev": {
      "description": "Start development server",
      "cache": false,
      "persistent": true
    },
    "lint": {
      "description": "Run linter",
      "cache": true,
      "outputs": ["coverage/**"]
    },
    "test": {
      "description": "Run tests",
      "cache": true,
      "outputs": ["coverage/**"]
    }
  },
  "globalDependencies": ["**/.env", "**/.env.local"],
  "globalEnv": []
}
